# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube a GitHub.

# PostgreSQL (servicio compartido por Compose y por Pedidos)
POSTGRES_DB=pedidos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Generar cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-segura-generada-con-el-comando-de-arriba
JWT_SIGNING_KEY=cambiar-por-otra-clave-segura-compartida-con-inventario

# Clave compartida para el header X-Service-Token entre Pedidos e Inventario
SERVICE_TOKEN=cambiar-por-una-clave-compartida-entre-pedidos-e-inventario

# Orígenes permitidos por CORS: frontend en Docker (8080) y servidor de desarrollo (5500)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500
